DATABASE_URL="postgresql://app:app@localhost:5432/study_abroad"
# At least 32 random characters, e.g. `openssl rand -base64 48`
AUTH_SECRET=""
# Local folder for uploaded documents (S3 adapter planned)
UPLOAD_DIR="./uploads"
# console | meta (Meta WhatsApp Cloud API)
WHATSAPP_PROVIDER="console"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
# App secret from the Meta app, used to verify webhook signatures (required in production)
WHATSAPP_APP_SECRET=""
# Dates are shown in this timezone
TZ="Asia/Kolkata"

# Document storage. Leave the Supabase values empty to store files on local disk (development only:
# app hosts wipe the disk on each deploy). Service role key: Supabase > Settings > API.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="student-documents"
# Lets an uptime monitor call /api/health without signing in
HEALTH_TOKEN=""
# One secret for all three scheduled endpoints, sent as "Authorization: Bearer <this>":
#   POST /api/cron/crm        every ten minutes, drains the queue to Medcity's own CRM
#   POST /api/cron/documents  daily, chases students and flags expiring documents
#   POST /api/cron/cricos     monthly, refreshes Australia's course register
# At least 24 characters. Empty or shorter keeps all three off rather than open.
CRON_SECRET=""
