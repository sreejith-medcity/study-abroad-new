# Copy to deploy/.env on the VPS and fill it in there. This file never holds
# a real value, and .env is never committed. Values are read by docker compose,
# so write them bare, without quotes.
#
# Every variable the portal reads is here. DATABASE_URL and UPLOAD_DIR are not,
# because docker-compose.yml builds them itself from the password below and
# the uploads volume.

# The database password, made on the box and never leaving it:
#   openssl rand -hex 24
# Hex only. It goes into a URL, so / @ # ? or % in it would break the
# connection string. It is set once, when the pgdata volume is first created;
# changing it later means changing it inside Postgres too.
POSTGRES_PASSWORD=

# Signs the session cookies. At least 32 characters. Keeping the one the live
# site uses means nobody is signed out by the move; a new one signs everybody
# out once.
AUTH_SECRET=

# The address people reach the portal on, with the scheme and no trailing
# slash. Links in WhatsApp messages, the student portal and the branch QR codes
# are built from it, so it must be the real one. The test name while testing,
# then the live name at cutover.
PUBLIC_BASE_URL=https://doc.medcityoverseas.com

# The port on 127.0.0.1 the app is published on and Caddy passes to. Must match
# reverse_proxy in Caddyfile.portal.
APP_PORT=3200

# Stamped into the build so the portal can say which commit it runs. Not read
# from this file: set it on the command line when building, as the README says.
# APP_COMMIT=

# The five scheduled jobs (/api/cron/*) accept only this, as
# "Authorization: Bearer <value>". At least 24 characters, or they all answer
# 401 to everybody. It must equal the CRON_SECRET repository secret in GitHub,
# because .github/workflows/schedules.yml is what calls them.
CRON_SECRET=

# Lets an uptime monitor read the detailed /api/health?token=<value> without
# signing in. Anyone without it still gets a bare ok or not-ok. Optional.
HEALTH_TOKEN=

# Payments through Razorpay Checkout. All three empty keeps payments off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp to students. "console" prints every message to the container log
# and sends nothing; "meta" sends through the Meta Cloud API and needs the
# four values after it.
WHATSAPP_PROVIDER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# The AI helpers (the brief, drafting). Empty keeps them off.
ANTHROPIC_API_KEY=

# Only read by the seed script, never by the running portal. Harmless empty.
SUPER_ADMIN_EMAIL=

# Rupee estimates for foreign-currency commission, for example
# GBP:115,EUR:98,AUD:60. Empty shows the foreign amount only.
COMMISSION_FX=

# Leave these three empty on the VPS. Set, the portal would write new uploads
# back into Supabase Storage instead of the uploads volume. They exist so the
# compose file lists everything the app can read.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=student-documents
