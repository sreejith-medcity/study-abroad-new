# Copy to deploy/.env on the VPS and fill it in there. This file never holds
# a real value, and .env is never committed.

# Made on the box: openssl rand -base64 30
POSTGRES_PASSWORD=
# Must be at least 32 characters. Keeping the one the live site uses means
# nobody is signed out by the move; a new one signs everybody out once.
AUTH_SECRET=
# The address people reach the portal on, with the scheme. Links in emails and
# on the student portal are built from it, so it must be the real one.
PUBLIC_BASE_URL=https://doc.medcityoverseas.com
# The port Caddy passes to on 127.0.0.1.
APP_PORT=3200

# Everything below is copied from what the live site uses today. Anything left
# empty simply turns that feature off rather than breaking the portal.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
WHATSAPP_PROVIDER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
ANTHROPIC_API_KEY=
SUPER_ADMIN_EMAIL=
COMMISSION_FX=
DOC_CODES=
CRON_SECRET=
HEALTH_TOKEN=
