# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env
# Documents uploaded in development land here. Anchored to the repository
# root on purpose: written bare, this pattern also swallowed
# src/app/api/uploads, so the route the browser posts documents to was never
# committed and the live site answered 500 for every upload.
/uploads/
!.env.example

# The VPS kit: dumps, the Supabase copy of the documents, and the build cache
/deploy/backups/
/deploy/documents/
/deploy/__pycache__/
